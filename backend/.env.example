# Supabase (spec 1: DB/Auth/Storage/Realtime on Supabase)
# Direct Postgres is REQUIRED in production for money/transactional paths (H2):
# advisory locks, SERIALIZABLE transactions, FOR UPDATE. Never downgrade these
# to REST fallback (see requireDirectPg / dbGuard.js).
#
# Which connection string to use (Supabase dashboard → Connect):
# - Persistent backend on IPv6 (or with IPv4 add-on): DIRECT
#     postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres
# - Persistent backend on an IPv4-only network (no add-on): SHARED POOLER, SESSION MODE (:5432)
#     postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Session mode behaves like direct (supports advisory locks/transactions) and is IPv4-only.
# - NEVER use transaction mode (:6543) for this backend: it does NOT support
#   advisory locks, SET/LISTEN, or multi-statement transactions. The backend logs
#   a startup warning if a :6543 URL is detected.
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend URL for CORS — REQUIRED in production (exact origin, no wildcard)
FRONTEND_URL=http://localhost:5178
# Optional extra CORS origins (comma-separated, no wildcard — credentials/JWT
# require explicit origins). Used for phone testing through a Dev Tunnel, e.g.:
# FRONTEND_URLS=https://k56cd01z-5178.asse.devtunnels.ms

# NODE_ENV must be "production" in deployed environments.
# Startup fails fast when critical keys are missing (values are never logged).
NODE_ENV=development

# Groq fallback for chatbot (spec 4.8, server-side only — never in frontend per spec 5.6)
GROQ_API_KEY=gsk_...

# Payments sandbox (spec 1: PayMongo — server-side only per spec 5.6)
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...
# Webhook signing secret from PayMongo dashboard. REQUIRED in production.
# When set, invalid signatures are rejected (403). Leave unset only for local/dev testing.
PAYMONGO_WEBHOOK_SECRET=whsec_...
# NEVER set to true in production — unverified money events are rejected instead.
# ALLOW_INSECURE_PAYMONGO_WEBHOOKS=true

# Email (spec 4.6: Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ATANY <noreply@atany.ph>
# Where Contact Us / Customer Help & Support notifications are delivered.
SUPPORT_RECIPIENT_EMAIL=goldjewelryauction@gmail.com

# ── Outgoing email provider ────────────────────────────────────────────────
# gmail  = Gmail SMTP (needs a Google APP PASSWORD, never the normal password)
# resend = the original Resend HTTP API
EMAIL_PROVIDER=gmail

# Gmail SMTP settings (credentials are read ONLY from the environment).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER is the Gmail address ATANY sends from.
SMTP_USER=
# SMTP_PASS is a 16-character Google APP PASSWORD (requires 2-Step Verification).
# NEVER commit a real App Password; NEVER use the normal Gmail password here.
SMTP_PASS=
# Optional explicit From header. Defaults to "ATANY Support <SMTP_USER>".
SMTP_FROM=

PORT=4000
