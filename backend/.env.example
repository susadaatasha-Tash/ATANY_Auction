# Supabase (spec 1: DB/Auth/Storage/Realtime on Supabase)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5178

# Groq fallback for chatbot (spec 4.8, server-side only — never in frontend per spec 5.6)
GROQ_API_KEY=gsk_...

# Payments sandbox (spec 1: PayMongo — server-side only per spec 5.6)
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...

# Email (spec 4.6: Resend)
RESEND_API_KEY=re_...

PORT=4000
