# ATANY Backend — Copy to backend/.env and fill in real values.
# Never commit .env with real secrets.

PORT=4000
NODE_ENV=development

# Supabase — must match the same project as frontend VITE_SUPABASE_URL
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Database — direct Postgres connection (required for money paths)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# PayMongo (sandbox for dev)
PAYMONGO_SECRET_KEY=sk_test_<...>
PAYMONGO_WEBHOOK_SECRET=<webhook-signing-secret>
ALLOW_INSECURE_PAYMONGO_WEBHOOKS=false

# Frontend origin (CORS allowlist)
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=re_<...>
# The authorized ATANY sender (Resend-verified domain). Required in production.
RESEND_FROM_EMAIL=ATANY <support@your-verified-domain.example>

# ATANY Support — the single official support destination for every support
# flow (public contact, customer portal, shop owner portal, suspended-account
# inquiries, expired-winner inquiries, billing/payment questions).
ATANY_SUPPORT_EMAIL=goldjewelryauction@gmail.com

# Chatbot (Groq, server-side only — never in frontend)
GROQ_API_KEY=gsk_<...>
