VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:5178
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# PayMongo PUBLISHABLE key only (pk_...). Never put the secret key here.
# Enables secure card entry (PayMongo.js Elements) in the payment-method modal.
# Backend GET /billing/paymongo-config is used as a fallback if this is empty.
VITE_PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
